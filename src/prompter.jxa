// 提词悬浮窗（macOS）：osascript -l JavaScript src/prompter.jxa <提词页地址>
// 系统自带的窗口 + WebKit 网页视图，不依赖浏览器：没有地址栏、标签栏和红黄绿按钮，浮在所有窗口（包括全屏 Chrome）上面。
// 顶部一条透明标题栏区域用来拖动；窗口位置和大小由系统按 autosave 名字记住，下次打开回到原处。
// 由 ateam serve 启动（POST /api/prompter/open）；网页上的置顶、关闭按钮通过地址的 # 部分通知这里。
ObjC.import('Cocoa');
ObjC.import('WebKit');

function run(argv) {
  const url = argv[0];
  const app = $.NSApplication.sharedApplication;
  app.setActivationPolicy(1); // Accessory：不进程序坞、不抢菜单栏

  const vis = $.NSScreen.mainScreen.visibleFrame;
  const w = Math.min(1200, vis.size.width - 40);
  const h = 150;
  const rect = $.NSMakeRect(vis.origin.x + (vis.size.width - w) / 2, vis.origin.y + 8, w, h);
  // Titled | Resizable | FullSizeContentView：保留可拖动的标题栏区域，但让网页铺满整个窗口
  const win = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer(rect, 1 | 8 | 32768, 2, false);
  win.titlebarAppearsTransparent = true;
  win.titleVisibility = 1; // Hidden
  for (const b of [0, 1, 2]) win.standardWindowButton(b).setHidden(true);
  win.level = 3; // Floating：盖在普通窗口上
  win.collectionBehavior = 1 | 256; // 所有桌面都显示；能浮在全屏窗口上
  win.releasedWhenClosed = false;
  // 窗口本身全透明，底色由网页画（半透明深色），后面的内容能透出来
  win.opaque = false;
  win.backgroundColor = $.NSColor.clearColor;
  win.setFrameAutosaveName('ateam-prompter');

  const web = $.WKWebView.alloc.initWithFrameConfiguration(win.contentView.bounds, $.WKWebViewConfiguration.alloc.init);
  web.autoresizingMask = 2 | 16; // 宽高跟着窗口
  try { web.setValueForKey($.NSNumber.numberWithBool(false), 'drawsBackground'); } catch (e) {} // 加载前不闪白
  win.contentView.addSubview(web);
  web.loadRequest($.NSURLRequest.requestWithURL($.NSURL.URLWithString(url)));

  // 拖动条：网页会抢标题栏区域的鼠标事件，拖动时灵时不灵。顶部 28px 盖一层透明的原生视图，
  // 它不处理鼠标，事件交给窗口按背景拖动，按住这一条一定能拖
  win.movableByWindowBackground = true;
  const b = win.contentView.bounds;
  const grip = $.NSView.alloc.initWithFrame($.NSMakeRect(0, b.size.height - 28, b.size.width, 28));
  grip.autoresizingMask = 2 | 8; // 宽度跟着窗口，贴住顶部
  win.contentView.addSubviewPositionedRelativeTo(grip, 1, web); // 放在网页上面

  // 网页上的按钮通过地址的 # 部分告诉窗口：pin=0/1 置顶开关，close=1 关闭
  let lastFrag = null;
  $.NSTimer.scheduledTimerWithTimeIntervalRepeatsBlock(0.3, true, () => {
    const u = web.URL;
    if (!u || u.isNil()) return;
    const frag = ObjC.unwrap(u.fragment) || '';
    if (frag === lastFrag) return;
    lastFrag = frag;
    if (/(^|&)close=1/.test(frag)) { app.terminate(null); return; }
    win.level = /(^|&)pin=0/.test(frag) ? 0 : 3;
  });

  win.orderFrontRegardless; // 不抢焦点，演播的浏览器还是当前窗口
  app.run;
}
